import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

dados = pd.read_csv(
    "datatran2024.csv",
    encoding="latin1",
    sep=";"
)

totais = pd.DataFrame({
    "Situação": ["Feridos", "Mortos", "Ilesos"],
    "Quantidade": [
        dados["feridos"].sum(),
        dados["mortos"].sum(),
        dados["ilesos"].sum()
    ]
})

sns.barplot(
    data=totais,
    x="Situação",
    y="Quantidade"
)

plt.title("Pessoas envolvidas em sinistros - PRF 2024")
plt.xlabel("Situação")
plt.ylabel("Quantidade de pessoas")

plt.show()
mortos = dados.groupby(
    ["condicao_metereologica", "fase_dia"]
)["mortos"].sum().reset_index()

plt.figure(figsize=(14, 7))

sns.barplot(
    data=mortos,
    x="condicao_metereologica",
    y="mortos",
    hue="fase_dia"
)

condicao = df["condicao_metereologica"].value_counts()

plt.figure(figsize=(11, 8))

wedges, texts, autotexts = plt.pie(
    condicao,
    autopct="%1.1f%%",
    startangle=90,
    pctdistance=0.7,
    textprops={"fontsize": 9}
)

plt.legend(
    wedges,
    condicao.index,
    title="Condição meteorológica",
    loc="center left",
    bbox_to_anchor=(1, 0.5),
    fontsize=9
)

plt.title(
    "Acidentes por condição meteorológica - PRF 2024",
    fontsize=14
)

plt.tight_layout()
plt.show()

